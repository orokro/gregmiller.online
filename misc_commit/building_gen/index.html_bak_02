<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Building Generator</title>
    <link rel="stylesheet" href="style.css">
    <script type="importmap">
        {
            "imports": {
                "three": "./node_modules/three/build/three.module.js",
                "three/addons/": "./node_modules/three/examples/jsm/"
            }
        }
    </script>
</head>
<body>
    <div id="canvas-container"></div>
    <div id="sidebar">
        <h2>Settings</h2>
        
        <div class="control-group">
            <label for="seed">Seed:</label>
            <input type="text" id="seed" value="gemini_builds">
        </div>

        <div class="control-group">
            <label for="blockSize">Block Size:</label>
            <input type="number" id="blockSize" value="1" min="1" max="10">
        </div>

        <div class="control-group">
            <label for="spacing">Spacing:</label>
            <input type="number" id="spacing" value="1.5" step="0.1">
        </div>

        <div class="control-group">
            <label for="hdrIntensity">HDR Intensity:</label>
            <input type="range" id="hdrIntensity" min="0" max="2" step="0.1" value="1.0">
        </div>

        <div class="control-group">
            <button id="regenerate">Regenerate</button>
        </div>

        <div class="control-group" style="flex-grow: 1; display: flex; flex-direction: column;">
            <label for="settingsJson">Generation Config (JSON):</label>
            <textarea id="settingsJson"></textarea>
        </div>
    </div>

    <script type="module" src="src/main.js"></script>
</body>
</html>
